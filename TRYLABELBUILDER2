body.noglow .glow{display:none}
.fl{position:absolute;bottom:-30px;font-size:22px;opacity:0;animation:rise linear infinite}
@keyframes rise{0%{transform:translateY(0) scale(.8);opacity:0}12%{opacity:.5}90%{opacity:.25}100%{transform:translateY(-105vh) scale(1.15);opacity:0}}
.collapse{cursor:pointer;user-select:none}
.toastbox{position:fixed;right:14px;bottom:14px;display:flex;flex-direction:column;gap:8px;z-index:99}
.toast{background:#241a10;border:1px solid var(--gold2);color:var(--txt);border-radius:10px;padding:10px 14px;font-size:12px;max-width:320px;animation:tin .25s}
.toast.err{border-color:var(--bad)}
@keyframes tin{from{transform:translateX(30px);opacity:0}}
