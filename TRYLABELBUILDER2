<style>
:root{--bg:#0c0805;--card:#171009;--card2:#201710;--line:#33261a;--txt:#f3e7d8;--mut:#b39a7c;--gold:#e8b04b;--gold2:#c98f2e;--ok:#7fd98a;--bad:#ff8d7e;--chip:#2a1e12;--mono:ui-monospace,SFMono-Regular,Menlo,monospace}
*{box-sizing:border-box;margin:0;padding:0}
body{background:radial-gradient(1200px 700px at 50% -10%,#1d1309 0%,var(--bg) 60%);color:var(--txt);font-family:Inter,system-ui,sans-serif;min-height:100vh;padding:18px 14px 40px}
.wrap{max-width:1060px;margin:0 auto;display:flex;flex-direction:column;gap:16px;position:relative;z-index:1}
.brand{text-align:center;padding:14px 0 4px}
.brand h1{font-family:'Cormorant Garamond',serif;font-size:30px;letter-spacing:3px;color:var(--gold)}
.brand .sub{font-size:12px;letter-spacing:4px;text-transform:uppercase;color:var(--mut);margin-top:2px}
.badge{display:inline-block;margin-top:8px;background:linear-gradient(135deg,var(--gold),var(--gold2));color:#241503;font-weight:700;font-size:11px;padding:4px 12px;border-radius:20px;letter-spacing:1px}
.banner{display:none;background:#3a1410;border:1px solid #7a2c22;color:#ffb4aa;border-radius:12px;padding:12px 16px;font-size:13px;text-align:center}
.banner.show{display:block}
.card{background:linear-gradient(180deg,var(--card),#130d07);border:1px solid var(--line);border-radius:16px;padding:16px}
.card h2{font-size:14px;letter-spacing:.6px;margin-bottom:12px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.card h2 .cnt{background:var(--chip);color:var(--gold);border-radius:12px;padding:1px 10px;font-size:12px}
table.set{width:100%;border-collapse:collapse;font-size:13px}
table.set td{padding:5px 8px;border-bottom:1px dashed #2a1f14;vertical-align:middle}
table.set td:first-child{color:var(--mut);width:44%}
input[type=number],select{background:#0e0a06;border:1px solid var(--line);color:var(--txt);border-radius:8px;padding:6px 8px;font-size:13px;width:84px}
