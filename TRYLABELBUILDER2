<script>
'use strict';
/* WAX & WICKS BY JIA • Label & Manifest Studio v7.0
   v7.0 = ONLY summary extraction upgraded:
   • Courier name from MANIFEST header (works even if label has no courier text)
   • AWB deep-link: label ↔ manifest row, blanks filled cross-document
   • OCR assist (Tesseract) for text-less pages + logo/branding zones
   • On-screen "Summary Data Check" panel + self-download + IST stamp
   Cropping, manifest stacking, margins, rotate, integrity, glow — untouched. */
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const IN=72, LSKEY='wwbj_studio_v7';
const BRANDS=[
 ['Amazon ATS',/amazon\s*ats|ats\s+(order\s*)?manifest/i],
 ['Amazon',/amazon|ship\.amazon|amazon\s*shipping|amazon\.in/i],
 ['Delhivery',/delhivery/i],['Ecom Express',/ecom\s*express/i],
 ['Blue Dart',/blue\s*dart|bluedart/i],['XpressBees',/xpress\s*bees|xpressbees/i],
 ['Shiprocket',/shiprocket/i],['Ekart',/ekart/i],['Shadowfax',/shadowfax/i],
 ['India Post',/india\s*post|speed\s*post|\bdop\b/i],['DTDC',/dtdc/i],['Gati',/\bgati\b/i],
 ['Professional Couriers',/professional\s*courier/i],['First Flight',/first\s*flight/i],
 ['Safexpress',/safexpress/i],['Trackon',/trackon/i],['Omni Parcel',/omni\s*parcel|omniparcel/i],
 ['Mahindra Logistics',/mahindra\s*logistics/i],['FedEx',/fedex/i],['DHL',/\bdhl\b/i],['UPS',/\bups\b/i]
];
let state={entries:[],docs:{},built:null,blobUrl:null,uid:0,busy:false,records:[]};
let tessWorker=null;

const DEF={w:4,h:6,unit:'in',mT:.15,mR:.35,mB:.15,mL:.15,rotate:false,autoRotate:true,sameM:true,pickup:true,autoOpen:false,enlarge:true,integrity:true,xcheck:true,ocr:true,maxPer:4,gap:.12,prec:'200'};
let S; try{S=Object.assign({},DEF,JSON.parse(localStorage.getItem(LSKEY)||'{}'));}catch(e){S={...DEF};}
const saveS=()=>localStorage.setItem(LSKEY,JSON.stringify(S));
const toDisp=v=>S.unit==='cm'?(v*2.54):v, fromDisp=v=>S.unit==='cm'?(v/2.54):v;
const istNow=()=>{try{return new Date().toLocaleString('en-IN',{timeZone:'Asia/Kolkata',day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit',hour12:true}).replace(/(,\s*)| at /g,' • ')+' IST';}catch(e){return new Date().toLocaleString()+' (local)';}};

function toast(msg,err){const t=document.createElement('div');t.className='toast'+(err?' err':'');t.textContent=msg;$('#toasts').appendChild(t);setTimeout(()=>t.remove(),5200);}
function prog(p,txt){$('#pFill').style.width=p+'%';$('#pTxt').textContent=txt;}
function esc(s){return String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}
function detectBrand(text,src='text'){if(!text)return{name:'Unknown',src:'—'};for(const[n,r]of BRANDS){if(r.test(text))return{name:n,src};}return{name:'Unknown',src:'—'};}
function collapseDigits(t){return t.replace(/(\d)[ \-_.·](?=\d)/g,'$1');}
function findAWB(text){
  if(!text)return'';const t=collapseDigits(text);const c=[];
  for(const m of t.matchAll(/\d{10,16}/g)){
    const before=t.slice(Math.max(0,m.index-16),m.index);let sc=m[0].length===12?2:(m[0].length>=11?1:0);
    if(/awb|tracking|consign/i.test(before))sc+=5;
    if(/m:|mob|ph|tel|\+91|alternat/i.test(before))sc-=6;
    c.push({s:m[0],sc});
  }
  c.sort((a,b)=>b.sc-a.sc);return c.length?c[0].s:'';
}
const PIN_RE=/\b([1-9]\d{5})\b/;
function parseAddress(cell){
  cell=(cell||'').replace(/\s+/g,' ').trim();
  const pin=(cell.match(PIN_RE)||[])[1]||'';
  const city=(cell.match(/,\s*([A-Za-z][A-Za-z .\-]{2,28}),?\s*\d{6}/)||[])[1]||'';
  const st=(cell.match(/\d{6}\s*,?\s*([A-Za-z][A-Za-z .]{3,25})/)||[])[1]||'';
  const name=(cell.split(/[,|]/)[0]||'').trim();
  return{raw:cell,name,city,state:st,pin};
}
function parseWeight(t){
  const m=(t.match(/(\d+(?:\.\d+)?)\s*(kgs?|k\.g\.?s?|gms?|grams?|g)\b/i)||[]);
  if(!m.length)return'';let v=parseFloat(m[1]);if(/^g/i.test(m[2]))v=v/1000;
  return (Math.round(v*100)/100)+' kg';
}
function parsePayment(t){if(/\b(pre\s*-?\s*paid|prepaid)\b/i.test(t))return'PREPAID';if(/\b(cod|cash\s*on\s*delivery|to\s*collect|collect\s*on)\b/i.test(t))return'COD';return'';}

async function pageText(page){const tc=await page.getTextContent();return tc.items.map(i=>i.str).join(' ');}
async function pageRows(page){
  const tc=await page.getTextContent();const rows=[];
  for(const it of tc.items){if(!it.str.trim())continue;const y=it.transform[5],x=it.transform[4];
    let r=rows.find(r=>Math.abs(r.y-y)<=2.4);if(!r){r={y,items:[]};rows.push(r);}r.items.push({x,s:it.str});}
  rows.sort((a,b)=>b.y-a.y);
  return rows.map(r=>r.items.sort((a,b)=>a.x-b.x).map(i=>i.s));
}
async function renderCanvas(doc,pageIdx,dpi){
  const page=await doc.getPage(pageIdx);const vp0=page.getViewport({scale:1});
  const scale=Math.max(.5,Math.min(dpi/72,2600/Math.max(vp0.width,1)));
  const vp=page.getViewport({scale});
  const cv=document.createElement('canvas');cv.width=Math.floor(vp.width);cv.height=Math.floor(vp.height);
  await page.render({canvasContext:cv.getContext('2d',{willReadFrequently:true}),viewport:vp}).promise;
  return cv;
}
function autoCrop(cv,pad=6){
  const W=cv.width,H=cv.height,ctx=cv.getContext('2d',{willReadFrequently:true});
  const d=ctx.getImageData(0,0,W,H).data;let a=W,b=H,c=0,e=0,found=false;
  for(let y=0;y<H;y++){const row=y*W;for(let x=0;x<W;x++){const i=(row+x)*4;
    if(d[i]<245||d[i+1]<245||d[i+2]<245){found=true;if(x<a)a=x;if(x>c)c=x;if(y<b)b=y;if(y>e)e=y;}}}
  if(!found)return{cv};
  a=Math.max(0,a-pad);b=Math.max(0,b-pad);c=Math.min(W-1,c+pad);e=Math.min(H-1,e+pad);
  const o=document.createElement('canvas');o.width=c-a+1;o.height=e-b+1;
  o.getContext('2d').drawImage(cv,a,b,o.width,o.height,0,0,o.width,o.height);
  return{cv:o};
}
function rotate90(cv){const o=document.createElement('canvas');o.width=cv.height;o.height=cv.width;
  const g=o.getContext('2d');g.translate(o.width/2,o.height/2);g.rotate(Math.PI/2);g.drawImage(cv,-cv.width/2,-cv.height/2);return o;}
function cropRegion(cv,x,y,w,h,maxW){
  const s=Math.min(1,maxW/Math.max(w,1));const o=document.createElement('canvas');
  o.width=Math.max(1,Math.round(w*s));o.height=Math.max(1,Math.round(h*s));
  o.getContext('2d').drawImage(cv,x,y,w,h,0,0,o.width,o.height);return o;
}
async function ocrCanvas(cv){
  if(!S.ocr||!window.Tesseract)return'';
  try{
    if(!tessWorker){prog(99,'OCR: loading engine…');tessWorker=await Tesseract.createWorker('eng');}
    const r=await tessWorker.recognize(cv);return(r.data&&r.data.text)||'';
  }catch(e){return'';}
}
async function ocrBrand(cv){
  const W=cv.width,H=cv.height;
  const regions=[[Math.floor(W*.45),Math.floor(H*.55),W-Math.floor(W*.45),H-Math.floor(H*.55)],
                 [0,Math.floor(H*.62),W,H-Math.floor(H*.62)],
                 [0,0,W,Math.floor(H*.38)]];
  for(const[rx,ry,rw,rh]of regions){
    if(rw<80||rh<40)continue;
    const t=await ocrCanvas(cropRegion(cv,rx,ry,rw,rh,1000));
    const b=detectBrand(t,'ocr');if(b.name!=='Unknown')return b;
  }
  return{name:'Unknown',src:'—'};
}

function parseLabel(text){
  const p={awb:'',payment:'',weight:'',shipTo:{raw:'',name:'',city:'',state:'',pin:''},item:'',qty:'',orderId:''};
  let m=text.match(/awb[^0-9]{0,6}(\d[\d \-]{8,18})/i);
  p.awb=m?collapseDigits(m[1]).replace(/\D/g,''):findAWB(text);
  p.weight=parseWeight(text);p.payment=parsePayment(text);
  const sm=text.match(/ship\s*to\s*[:：]?\s*([\s\S]{5,300}?)(?=ship\s*date|pdd\s*[:：]|ordered\s*from|invoice|ship\s*from|gst)/i);
  p.shipTo=parseAddress(sm?sm[1]:text);
  const im=text.match(/qty\s*[:：]?\s*(\d+)\s*[-–—]\s*([A-Za-z][A-Za-z0-9 &\-\/()]{1,40})/i);
  if(im){p.qty=im[1];p.item=im[2].trim();}
  const om=text.match(/\b(\d{3,6}[A-Z]{2}\d{6,14})\b/);if(om)p.orderId=om[1];
  return p;
}
function parseManifest(text,rows){
  const p={courier:'Unknown',courierSrc:'—',manifestId:'',date:'',merchant:'',merchantId:'',rows:[]};
  const b=detectBrand(text,'header');p.courier=b.name;p.courierSrc=b.src;
  let m=text.match(/manifest\s*(?:id|no\.?|number)\s*[:#\-]?\s*([A-Za-z0-9\-]{4,})/i);if(m)p.manifestId=m[1];
  m=text.match(/manifest\s*date\s*[:#\-]?\s*([0-9]{1,2}[\/\- .][A-Za-z0-9]{2,9}[\/\- .][0-9]{2,4}|[0-9]{1,2}[\/\-][0-9]{1,2}[\/\-][0-9]{2,4})/i);if(m)p.date=m[1];
  m=text.match(/warehouse\s*[:：]\s*([^,\n]{2,60})/i);if(m)p.merchant=m[1].trim();
  m=text.match(/merchant\s*id\s*[:：]?\s*(\d+)/i);if(m)p.merchantId=m[1];
  for(const cells of (rows||[])){
    const join=cells.join(' | ');
    if(/awb\s*barcode|shipper\s*info|item\s*name|sku/i.test(join))continue;
    if(/merchant\s*signature|courier\s*signature/i.test(join))continue;
    const awb=findAWB(join);const pay=parsePayment(join);
    if(!awb&&!pay)continue;
    const row={awb,payment:pay,orderId:'',addr:{raw:'',name:'',city:'',state:'',pin:''},item:'',qty:''};
    const om=join.match(/#\s*([A-Za-z0-9]{7,})/);if(om)row.orderId=om[1];
    else{const o2=join.match(/\b(\d{3,6}[A-Z]{2}\d{6,14})\b/);if(o2)row.orderId=o2[1];}
    let addrCell='',itemCell='';const small=[];
    cells.forEach((c,i)=>{const cc=c.trim();if(!cc)return;
      if(PIN_RE.test(cc)&&cc.length>addrCell.length)addrCell=cc;
      else if(/^\d{1,2}$/.test(cc))small.push({i,v:cc});
      else if(/^[A-Za-z][A-Za-z0-9 &\-()\/]{1,32}$/.test(cc)&&!/prepaid|cod|shipper|item|boxes|order|awb|date|name/i.test(cc))itemCell=cc;});
    if(!addrCell){let best='';cells.forEach(c=>{if(c.length>best.length&&/[A-Za-z]{3}/.test(c)&&!/awb|order|signature|manifest/i.test(c))best=c;});addrCell=best;}
    row.addr=parseAddress(addrCell);row.item=itemCell;
    if(small.length>=2)row.qty=small[1].v;else if(small.length===1&&small[0].i>0)row.qty=small[0].v;
    p.rows.push(row);
  }
  return p;
}
function classify(w,h,text){
  const t=(text||'').toLowerCase();let lab=0,man=0;
  if(/manifest/.test(t))man+=3;if(/order\s*manifest|manifest\s*id/.test(t))man+=2;
  if(/shipper\s*info|awb\s*barcode|sku/.test(t))man+=2;
  if(w>550||h>760)man+=2;
  if(/awb/.test(t))lab+=2;if(/ship\s*to/.test(t))lab+=2;if(/shipping\s*label|delivery\s*station/.test(t))lab+=2;
  const r=h/Math.max(w,1);if(r>1.15&&r<2.4&&w<450)lab+=2;
  if(man>lab)return'manifest';if(lab>man)return'label';
  return(w>550||h>760)?'manifest':'label';
}

async function ensureCrop(e){
  if(e.cropCv&&!e.dirty)return;
  const cv=await renderCanvas(e.doc,e.pageIdx,parseInt(S.prec,10));
  e.cropCv=autoCrop(cv).cv;e.cropW=e.cropCv.width;e.cropH=e.cropCv.height;e.dirty=false;
}
async function ensureCropLite(e){if(!e.cropCv){const cv=await renderCanvas(e.doc,e.pageIdx,150);e.cropCv=autoCrop(cv,4).cv;}}
function makeThumb(cv){const o=document.createElement('canvas');const s=66/Math.max(cv.width,1);
  o.width=Math.max(1,Math.round(cv.width*s));o.height=Math.max(1,Math.round(cv.height*s));
  o.getContext('2d').drawImage(cv,0,0,o.width,o.height);return o;}

async function addFiles(list){
  if(!window.pdfjsLib){toast('PDF libraries not loaded yet.',true);return;}
  state.built=null;
  for(const f of list){
    try{
      const bytes=new Uint8Array(await f.arrayBuffer());
      const doc=await pdfjsLib.getDocument({data:bytes.slice(0)}).promise;
      const fid='F'+(++state.uid);state.docs[fid]={doc,bytes};
      for(let pg=1;pg<=doc.numPages;pg++){
        const page=await doc.getPage(pg);const vp=page.getViewport({scale:1});
        let text=await pageText(page);let ocrUsed=false;
        if(text.trim().length<25&&S.ocr){
          prog(5,'OCR: reading '+f.name+' …');
          text=await ocrCanvas(await renderCanvas(doc,pg,200));ocrUsed=true;
        }
        const kind=classify(vp.width,vp.height,text);
        const e={id:'E'+(++state.uid),fid,doc,pageIdx,name:f.name+(doc.numPages>1?' · p'+pg:''),
          kind,text,ocrUsed,courier:'Unknown',courierSrc:'—',awb:'',parsed:null,cropCv:null,dirty:true,thumb:null};
        if(kind==='manifest'){
          e.parsed=parseManifest(text,await pageRows(page));e.courier=e.parsed.courier;e.courierSrc=e.parsed.courierSrc;
          e.awb=(e.parsed.rows[0]||{}).awb||'';
        }else{
          e.parsed=parseLabel(text);e.awb=e.parsed.awb;
          let b=detectBrand(text,'text');
          if(b.name==='Unknown'&&S.ocr){await ensureCropLite(e);b=await ocrBrand(e.cropCv);}
          e.courier=b.name;e.courierSrc=b.src;
        }
        await ensureCropLite(e);
        e.thumb=makeThumb(e.cropCv);
        state.entries.push(e);
      }
    }catch(err){console.error(err);toast('Could not read: '+f.name,true);}
  }
  linkAll();renderAll();
}

function linkAll(){
  const map=new Map();
  state.entries.filter(e=>e.kind==='manifest').forEach(e=>{
    (e.parsed.rows||[]).forEach(r=>{r._m=e;r.matched=false;if(r.awb&&!map.has(r.awb))map.set(r.awb,r);});
  });
  const recs=[];
  state.entries.filter(e=>e.kind==='label').forEach(e=>{
    const L=e.parsed||{};const mr=L.awb?map.get(L.awb):null;
    if(mr)mr.matched=true;
    const addr=mr?mr.addr:(L.shipTo||{});
    const dest=(addr.name||'')+(addr.city?', '+addr.city:(addr.state?', '+addr.state:''))+(addr.pin?' – '+addr.pin:'');
    recs.push({
      courier:(mr&&mr._m.courier!=='Unknown')?mr._m.courier:(e.courier!=='Unknown'?e.courier:(mr?mr._m.courier:'Unknown')),
      courierSrc:(mr&&mr._m.courier!=='Unknown')?mr._m.courierSrc:e.courierSrc,
      awb:L.awb||(mr?mr.awb:''),orderId:(mr&&mr.orderId)||L.orderId||'',
      payment:(mr&&mr.payment)||L.payment||'',weight:L.weight||(mr?parseWeight(mr._m.text):''),
      dest:dest||'—',item:(mr&&mr.item)||L.item||'',qty:(mr&&mr.qty)||L.qty||'',
      manifestId:mr?mr._m.parsed.manifestId:'',mDate:mr?mr._m.parsed.date:'',merchant:mr?mr._m.parsed.merchant:'',
      linked:!!mr,src:mr?'M+'+(e.ocrUsed?'O':'L'):(e.ocrUsed?'O':'L')
    });
  });
  state.entries.filter(e=>e.kind==='manifest').forEach(e=>{
    (e.parsed.rows||[]).forEach(r=>{
      if(r.matched)return;const a=r.addr||{};
      recs.push({courier:e.courier,courierSrc:e.courierSrc,awb:r.awb,orderId:r.orderId,payment:r.payment,
        weight:parseWeight(e.text),dest:(a.name||'')+(a.city?', '+a.city:(a.state?', '+a.state:''))+(a.pin?' – '+a.pin:'')||'—',
        item:r.item,qty:r.qty,manifestId:e.parsed.manifestId,mDate:e.parsed.date,merchant:e.parsed.merchant,linked:false,src:'M-only'});
    });
  });
  state.records=recs;
}

