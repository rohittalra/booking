function groupInOrder(list,keyFn){const m=new Map();for(const x of list){const k=keyFn(x);if(!m.has(k))m.set(k,[]);m.get(k).push(x);}return m;}
function swapInArr(arr,a,b){const ia=arr.indexOf(a),ib=arr.indexOf(b);arr[ia]=b;arr[ib]=a;}

