const pageSize=()=>{let w=S.w*IN,h=S.h*IN;if(S.rotate)[w,h]=[h,w];return[w,h];};
const margins=()=>({t:S.mT*IN,r:S.mR*IN,b:S.mB*IN,l:S.mL*IN});
function fit(iw,ih,bw,bh,enlarge,autorot){
  let s=Math.min(bw/iw,bh/ih),rot=false;
  if(autorot){const s2=Math.min(bw/ih,bh/iw);if(s2>s){s=s2;rot=true;}}
  if(!enlarge&&s>1)s=1;return{s,rot};
}
async function buildPDF(){
  if(state.busy)return;state.busy=true;$('#btnBuild').disabled=true;
  try{
    prog(2,'Preparing…');linkAll();
    const doc=await PDFLib.PDFDocument.create();
    const [pw,ph]=pageSize();const m=margins();
    const placements=[];let n=0;const total=state.entries.length+2;
    for(const e of state.entries.filter(x=>x.kind==='label')){
      prog(5+(n++/total)*70,'Placing label '+n+'…');
      await ensureCrop(e);
      const page=doc.addPage([pw,ph]);
      const bw=pw-m.l-m.r,bh=ph-m.t-m.b;
      let cv=e.cropCv,rot=false;
      const f=fit(cv.width,cv.height,bw,bh,S.enlarge,S.autoRotate);
      if(f.rot){cv=rotate90(cv);rot=true;}
      const img=await doc.embedPng(cv.toDataURL('image/png'));
      const dw=cv.width*f.s,dh=cv.height*f.s;
      const x=m.l+(bw-dw)/2,y=m.b+(bh-dh)/2;
      page.drawImage(img,{x,y,width:dw,height:dh});
      placements.push({pageNo:doc.getPageCount(),rect:[x,y,dw,dh],src:cv});
    }
    const pm=S.sameM?m:{t:10,r:10,b:10,l:10};
    const bw2=pw-pm.l-pm.r,gap=S.gap*IN,maxN=Math.max(1,S.maxPer|0);
    const mGroups=groupInOrder(state.entries.filter(x=>x.kind==='manifest'),e=>e.courier||'Unknown');
    for(const[,list]of mGroups){
      let batch=[];
      const flush=async()=>{
        if(!batch.length)return;
        prog(5+(n++/total)*70,'Stacking manifests…');
        const page=doc.addPage([pw,ph]);
        const objs=[];
        for(const e of batch){await ensureCrop(e);objs.push({img:await doc.embedPng(e.cropCv.toDataURL('image/png')),iw:e.cropCv.width,ih:e.cropCv.height});}
        let tot=objs.reduce((a,o)=>a+bw2*o.ih/o.iw,0)+gap*(objs.length-1);
        const avail=ph-pm.t-pm.b;const k=tot>avail?avail/tot:1;
        let y=ph-pm.t;
        for(const o of objs){
          const w=bw2*k,h=bw2*o.ih/o.iw*k;y-=h;
          page.drawImage(o.img,{x:pm.l+(bw2-w)/2,y,width:w,height:h});
          placements.push({pageNo:doc.getPageCount(),rect:[pm.l+(bw2-w)/2,y,w,h],src:null});
          y-=gap;
        }
        batch=[];
      };
      for(const e of list){batch.push(e);if(batch.length>=maxN)await flush();}
      await flush();
    }
    if(S.pickup&&state.records.length){prog(82,'Writing pickup summary…');addSummaryPages(doc,state.records,pw,ph);}
    prog(90,'Saving PDF…');
    const bytes=await doc.save();
    if(S.integrity||S.xcheck){
      prog(93,'✅ Auto Cross-Check / pixel integrity…');
      const ok=await integrity(bytes,placements);
      if(S.xcheck)toast(ok?'✅ Auto Cross-Check passed':'⚠️ Cross-Check: some pages re-embedded');
    }
    state.built=bytes;
    if(state.blobUrl)URL.revokeObjectURL(state.blobUrl);
    state.blobUrl=URL.createObjectURL(new Blob([bytes],{type:'application/pdf'}));
    $('#btnOpen').disabled=false;$('#btnDownload').disabled=false;$('#btnShare').disabled=false;
    prog(100,'Done ✅ '+state.records.length+' parcels in summary');
    renderPreviews();
    if(S.autoOpen)openPdf(1);
    toast('Built ✅ — summary: '+state.records.length+' parcels, '+new Set(state.records.map(r=>r.courier)).size+' courier(s)');
  }catch(err){console.error(err);toast('Build failed: '+err.message,true);prog(0,'Error');}
  state.busy=false;$('#btnBuild').disabled=!state.entries.length;
}
function addSummaryPages(doc,recs,pw,ph){
  const {StandardFonts,rgb}=PDFLib;
  const fB=doc.embedFont(StandardFonts.HelveticaBold),fR=doc.embedFont(StandardFonts.Helvetica);
  const m=S.sameM?margins():{t:10,r:10,b:10,l:10};
  const W=pw-m.l-m.r;
  const ink=rgb(.12,.08,.04),mut=rgb(.45,.36,.26),line=rgb(.85,.72,.45);
  for(const[courier,list]of groupInOrder(recs,r=>r.courier||'Unknown')){
    let page=doc.addPage([pw,ph]),y=ph-m.t,cont=false;
    const header=()=>{
      page.drawText(courier.toUpperCase()+' — PICKUP SUMMARY',{x:m.l,y:y-10,font:fB,size:10.5,color:ink});
      const meta=list[0];
      const l2=['Manifest: '+(meta.manifestId||'—'),meta.mDate?('Date: '+meta.mDate):'',meta.merchant?('Merchant: '+meta.merchant):'','Gen: '+istNow()].filter(Boolean).join('  •  ');
      page.drawText(l2.slice(0,220),{x:m.l,y:y-21,font:fR,size:6.3,color:mut});
      const cod=list.filter(r=>r.payment==='COD').length,pp=list.filter(r=>r.payment==='PREPAID').length;
      page.drawText('Parcels: '+list.length+(cod?'  •  COD: '+cod:'')+(pp?'  •  Prepaid: '+pp:'')+(cont?'  (contd.)':''),{x:m.l,y:y-31,font:fB,size:7,color:ink});
      y-=40;page.drawLine({start:{x:m.l,y:y},end:{x:m.l+W,y:y},thickness:.8,color:line});y-=4;
    };
    header();
    const rowH=26,sigReserve=58;
    list.forEach((r,i)=>{
      if(y-rowH<m.b+sigReserve){page=doc.addPage([pw,ph]);y=ph-m.t;cont=true;header();}
      const y1=y-9,y2=y-18;
      page.drawText('#'+(i+1)+'  AWB '+(r.awb||'—'),{x:m.l,y:y1,font:fB,size:7.3,color:ink});
      page.drawText((r.payment||'—')+(r.weight?'  •  '+r.weight:''),{x:m.l+W-16,y:y1,font:fR,size:7,color:ink});
      page.drawRectangle({x:m.l+W-11,y:y1-1.5,width:8,height:8,borderColor:ink,borderWidth:.9});
      const l2=[r.orderId,r.dest,(r.item?r.item+(r.qty?' ×'+r.qty:''):'')].filter(Boolean).join('   |   ');
      const maxCh=Math.floor(W/3.4);
      page.drawText((l2.length>maxCh?l2.slice(0,maxCh-1)+'…':l2)||'—',{x:m.l,y:y2,font:fR,size:6.6,color:mut});
      page.drawLine({start:{x:m.l,y:y-rowH+4},end:{x:m.l+W,y:y-rowH+4},thickness:.3,color:line});
      y-=rowH;
    });
    if(y-sigReserve<m.b){page=doc.addPage([pw,ph]);y=ph-m.t;}
    y-=14;
    const half=W/2-8;
    page.drawLine({start:{x:m.l,y:y},end:{x:m.l+half,y:y},thickness:.8,color:ink});
    page.drawLine({start:{x:m.l+half+16,y:y},end:{x:m.l+W,y:y},thickness:.8,color:ink});
    page.drawText('Merchant Signature / SPOC Name & Phone',{x:m.l,y:y-9,font:fR,size:6,color:mut});
    page.drawText('Courier Signature / SPOC Name & Phone',{x:m.l+half+16,y:y-9,font:fR,size:6,color:mut});
    page.drawText('Pickup verified  ☐      All parcels handed over  ☐',{x:m.l,y:y-24,font:fB,size:6.6,color:ink});
  }
}
async function integrity(bytes,placements){
  let allOk=true;
  try{
    const doc2=await pdfjsLib.getDocument({data:bytes.slice(0)}).promise;
    for(const p of placements){
      if(!p.src)continue;
      const pg=await doc2.getPage(p.pageNo);const vp0=pg.getViewport({scale:1});
      const vp=pg.getViewport({scale:140/vp0.width});
      const cv=document.createElement('canvas');cv.width=vp.width;cv.height=vp.height;
      await pg.render({canvasContext:cv.getContext('2d'),viewport:vp}).promise;
      const rx=p.rect[0]*vp.scale,ry=cv.height-(p.rect[1]+p.rect[3])*vp.scale;
      const rw=Math.max(8,p.rect[2]*vp.scale),rh=Math.max(8,p.rect[3]*vp.scale);
      const a=downsample(cropRegion(cv,rx,ry,rw,rh,64)),b=downsample(p.src);
      let d=0;for(let i=0;i<a.length;i++)d+=Math.abs(a[i]-b[i]);
      if(d/a.length>42)allOk=false;
    }
  }catch(e){allOk=false;}
  return allOk;
}
function downsample(cv){const o=document.createElement('canvas');o.width=12;o.height=16;
  o.getContext('2d').drawImage(cv,0,0,12,16);
  const d=o.getContext('2d').getImageData(0,0,12,16).data;const out=[];
  for(let i=0;i<d.length;i+=4)out.push((d[i]+d[i+1]+d[i+2])/3);return out;}
async function renderPreviews(){
  const box=$('#previews');box.innerHTML='';if(!state.built)return;
  const doc=await pdfjsLib.getDocument({data:state.built.slice(0)}).promise;
  $('#cntPages').textContent=doc.numPages;
  for(let i=1;i<=doc.numPages;i++){
    const pg=await doc.getPage(i);const vp0=pg.getViewport({scale:1});
    const vp=pg.getViewport({scale:150/vp0.width});
    const cv=document.createElement('canvas');cv.width=vp.width;cv.height=vp.height;
    await pg.render({canvasContext:cv.getContext('2d'),viewport:vp}).promise;
    const im=document.createElement('img');im.src=cv.toDataURL();im.title='Open at page '+i;
    im.onclick=()=>openPdf(i);box.appendChild(im);
  }
}

function openPdf(page){if(!state.blobUrl)return;window.open(state.blobUrl+'#page='+(page||1),'_blank');}
function dlBlob(blob,name){const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),4000);}
function stampName(){const d=new Date();return 'WaxWicks_Studio_Output_'+d.getFullYear()+('0'+(d.getMonth()+1)).slice(-2)+('0'+d.getDate()).slice(-2)+'_'+('0'+d.getHours()).slice(-2)+('0'+d.getMinutes()).slice(-2)+'.pdf';}

function bindSettings(){
  const put=()=>{
    $('#pgW').value=(+toDisp(S.w).toFixed(2));$('#pgH').value=(+toDisp(S.h).toFixed(2));
    $('#mT').value=(+toDisp(S.mT).toFixed(2));$('#mR').value=(+toDisp(S.mR).toFixed(2));
    $('#mB').value=(+toDisp(S.mB).toFixed(2));$('#mL').value=(+toDisp(S.mL).toFixed(2));
    $('#uW').textContent=S.unit;$('#uH').textContent=S.unit;$$('.u').forEach(x=>x.textContent=S.unit);
    $('#unitIn').classList.toggle('on',S.unit==='in');$('#unitCm').classList.toggle('on',S.unit==='cm');
    $('#optRotate').checked=S.autoRotate;$('#optSameM').checked=S.sameM;$('#optPickup').checked=S.pickup;
    $('#optAutoOpen').checked=S.autoOpen;$('#optEnlarge').checked=S.enlarge;$('#optIntegrity').checked=S.integrity;
    $('#optXCheck').checked=S.xcheck;$('#optOCR').checked=S.ocr;$('#optMax').value=S.maxPer;$('#optGap').value=S.gap;$('#optPrec').value=S.prec;
    $('#preset').value=(S.w===4&&S.h===6)?'4x6':(S.w===8.27&&S.h===11.69)?'a4':(S.w===8.5&&S.h===11)?'letter':'custom';
    viz();
  };
  put();
  $('#pgW').oninput=e=>{S.w=fromDisp(+e.target.value||4);saveS();viz();};
  $('#pgH').oninput=e=>{S.h=fromDisp(+e.target.value||6);saveS();viz();};
  $('#mT').oninput=e=>{S.mT=fromDisp(+e.target.value||0);saveS();viz();};
  $('#mR').oninput=e=>{S.mR=fromDisp(+e.target.value||0);saveS();viz();};
  $('#mB').oninput=e=>{S.mB=fromDisp(+e.target.value||0);saveS();viz();};
  $('#mL').oninput=e=>{S.mL=fromDisp(+e.target.value||0);saveS();viz();};
  $('#unitIn').onclick=()=>{S.unit='in';saveS();put();};
  $('#unitCm').onclick=()=>{S.unit='cm';saveS();put();};
  $('#btnRotate').onclick=()=>{S.rotate=!S.rotate;saveS();viz();toast('Output page '+(S.rotate?'rotated':'portrait'));};
  $('#btnDefault').onclick=()=>{S={...DEF};saveS();put();toast('Reset to 4×6 defaults');};
  $('#preset').onchange=e=>{const v=e.target.value;
    if(v==='4x6'){S.w=4;S.h=6;}if(v==='a4'){S.w=8.27;S.h=11.69;}if(v==='letter'){S.w=8.5;S.h=11;}
    saveS();put();};
  const ob=(id,k,cast)=>{$(id).onchange=e=>{S[k]=cast?cast(e.target.value):e.target.checked;saveS();if(k==='prec')state.entries.forEach(x=>x.dirty=true);};};
  ob('#optRotate','autoRotate');ob('#optSameM','sameM');ob('#optPickup','pickup');ob('#optAutoOpen','autoOpen');
  ob('#optEnlarge','enlarge');ob('#optIntegrity','integrity');ob('#optXCheck','xcheck');ob('#optOCR','ocr');
  ob('#optMax','maxPer',v=>Math.max(1,+v||4));ob('#optGap','gap',v=>+v||.12);ob('#optPrec','prec',v=>String(v));
  function viz(){
    const[pw,ph]=pageSize();const sc=150/Math.max(pw,ph);
    const pg=$('#vizPage');pg.style.width=(pw*sc)+'px';pg.style.height=(ph*sc)+'px';
    const m=margins();const pa=$('#vizPA');
    pa.style.left=(m.l*sc)+'px';pa.style.bottom=(m.b*sc)+'px';
    pa.style.width=((pw-m.l-m.r)*sc)+'px';pa.style.height=((ph-m.t-m.b)*sc)+'px';
    $('#vizTxt').innerHTML='Page '+(pw/IN).toFixed(2)+' × '+(ph/IN).toFixed(2)+' in'+(S.rotate?' (rotated)':'')+'<br>Printable area<br>Margin line — Unprinted margin';
  }
}
function glowInit(){
  const g=$('#glow');const em=['🕯️','✨','🔥','🕯️','✨'];
  for(let i=0;i<14;i++){const s=document.createElement('span');s.className='fl';
    s.textContent=em[i%em.length];s.style.left=(Math.random()*100)+'%';
    s.style.animationDuration=(9+Math.random()*14)+'s';s.style.animationDelay=(-Math.random()*18)+'s';
    s.style.fontSize=(14+Math.random()*16)+'px';g.appendChild(s);}
  $('#btnGlow').onclick=()=>{document.body.classList.toggle('noglow');
    $('#btnGlow').textContent=document.body.classList.contains('noglow')?'Studio Glow · Off':'Studio Glow · On';};
}
function init(){
  const st=istNow();$$('.stamp2').forEach(x=>x.textContent=st);
  if(!window.pdfjsLib||!window.PDFLib)$('#libBanner').classList.add('show');
  else pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  bindSettings();glowInit();
  const drop=$('#drop'),inp=$('#fileInp');
  drop.onclick=()=>inp.click();
  inp.onchange=()=>{if(inp.files.length)addFiles([...inp.files]);inp.value='';};
  ['dragover','dragenter'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add('over');}));
  ['dragleave','drop'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove('over');}));
  drop.addEventListener('drop',e=>{const fs=[...e.dataTransfer.files].filter(f=>/pdf$/i.test(f.name));if(fs.length)addFiles(fs);});
  $('#btnBuild').onclick=buildPDF;
  $('#btnOpen').onclick=()=>openPdf(1);
  $('#btnDownload').onclick=()=>{if(state.built)dlBlob(new Blob([state.built],{type:'application/pdf'}),stampName());};
  $('#btnShare').onclick=async()=>{
    if(!state.built)return;const f=new File([state.built],stampName(),{type:'application/pdf'});
    if(navigator.canShare&&navigator.canShare({files:[f]})){try{await navigator.share({files:[f],title:'Wax & Wicks labels'});}catch(e){}}
    else toast('Share not supported here — use Download.',true);
  };
  $('#btnClear').onclick=()=>{state.entries=[];state.docs={};state.records=[];state.built=null;
    if(state.blobUrl)URL.revokeObjectURL(state.blobUrl);state.blobUrl=null;
    $('#btnOpen').disabled=$('#btnDownload').disabled=$('#btnShare').disabled=true;
    $('#previews').innerHTML='';$('#cntPages').textContent='0';prog(0,'Ready');renderAll();};
  $('#sumHead').onclick=()=>{const b=$('#sumBody');b.style.display=b.style.display==='none'?'':'none';};
  $('#btnSaveApp').onclick=()=>{
    dlBlob(new Blob(['<!DOCTYPE html>\n'+document.documentElement.outerHTML],{type:'text/html'}),'WaxWicks_LabelManifest_Studio_v7.0.html');
    toast('App HTML downloaded ✅');
  };
  renderAll();
  console.log('WAX & WICKS BY JIA • Label & Manifest Studio v7.0 • Summary Deep-Link Engine + OCR');
}
document.addEventListener('DOMContentLoaded',init);
