.viz{display:flex;gap:18px;align-items:center;margin-top:14px;flex-wrap:wrap}
.viz .page{position:relative;border:2px solid var(--gold);flex:0 0 auto}
.viz .pa{position:absolute;border:1px dashed #7fd98a}
.viz .lb{font-size:10px;color:var(--mut);font-family:var(--mono)}
.hint{font-size:11px;color:var(--mut);margin-top:10px}
.drop{border:2px dashed #4a3826;border-radius:14px;padding:26px 14px;text-align:center;cursor:pointer;transition:.2s;background:#120c07}
.drop:hover,.drop.over{border-color:var(--gold);background:#1c130a}
.drop .big{font-size:15px;font-weight:600}
.drop .sm{font-size:11.5px;color:var(--mut);margin-top:6px}
.stats{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap}
.stat{flex:1;min-width:80px;background:var(--chip);border-radius:10px;padding:8px;text-align:center;font-size:12px;color:var(--mut)}
.stat b{display:block;font-size:18px;color:var(--gold)}
.items{display:flex;flex-direction:column;gap:8px;margin-top:10px}
.fcard{display:flex;gap:10px;align-items:center;background:var(--card2);border:1px solid var(--line);border-radius:12px;padding:8px 10px}
.fcard canvas{width:46px;height:66px;object-fit:contain;background:#fff;border-radius:4px;flex:0 0 auto}
.fcard .meta{flex:1;min-width:0}
.fcard .nm{font-size:12.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fcard .dt{font-size:11px;color:var(--mut);font-family:var(--mono);margin-top:3px;word-break:break-all}
.chip{display:inline-block;font-size:10px;border-radius:10px;padding:1px 8px;margin-right:4px;border:1px solid var(--line)}
